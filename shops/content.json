    {
      "id": "s-comm",
      "type": "services",
      "label": "COMMISSIONS",
      "sun": 205,
      "title": "What you can ask for",
      "sub": "Bring a drawing, a photograph, or a description of a dream",
      "items": [
        {
          "title": "Scenic carpentry",
          "blurb": "Flats, facades, platforms, staircases, decking, and full standing sets. Built to be struck, stored, and stood up again somewhere else next month.",
          "points": [
            "FLATS & FACADES",
            "PLATFORMS",
            "PRACTICAL BUILDS",
            "STANDING SETS"
          ],
          "lead": "2–6 WEEKS"
        },
        {
          "title": "Metal & rigging",
          "blurb": "Welded armatures, steel substructure, motion rigs, and the frame inside the thing that everyone assumes is solid wood.",
          "points": [
            "WELDING",
            "ARMATURES",
            "MOTION RIGS",
            "LOAD PATHS"
          ],
          "lead": "3–8 WEEKS"
        },
        {
          "title": "Sculpt & finish",
          "blurb": "Foam carving, moulds, casting, and paint treatments — ageing, marbling, faux stone, and finishes that survive a lighting package at two metres.",
          "points": [
            "FOAM CARVING",
            "MOULD & CAST",
            "SCENIC PAINT",
            "AGEING"
          ],
          "lead": "1–4 WEEKS"
        },
        {
          "title": "Breakaways & effects",
          "blurb": "Things designed to fail exactly once, on cue, safely, and again tomorrow if the take did not land.",
          "points": [
            "BREAKAWAYS",
            "COLLAPSES",
            "REPEATABLE GAGS"
          ],
          "lead": "BY QUOTE"
        },
        {
          "title": "Installation & experiential",
          "blurb": "Activations, retail sets, and public-facing builds that have to survive being touched by strangers for a fortnight.",
          "points": [
            "ACTIVATIONS",
            "RETAIL",
            "PUBLIC BUILDS",
            "TOURING"
          ],
          "lead": "4–10 WEEKS"
        }
      ],
      "note": "Rush work is possible and priced accordingly. If the date is the immovable part of the brief, say so first and we will design the build around it."
    },
    {
      "id": "s-process",
      "type": "process",
      "label": "PROCESS",
      "sun": 300,
      "title": "How a thing gets made",
      "sub": "Drawing to load-in, usually in five moves",
      "steps": [
        {
          "title": "The drawing",
          "text": "You arrive with plans, a sketch, a reference photograph, or a sentence. We work out what it actually has to do — hold a person, come apart, sit two metres from a lens — and what it only has to appear to do.",
          "src": "assets/img_0983.jpg",
          "caption": "DRAFTING"
        },
        {
          "title": "The estimate",
          "text": "Materials, hours, crew, and truck. One number, itemised, with the assumptions written down so we both know which of them the schedule depends on.",
          "src": "assets/img_5848.jpg",
          "caption": "ESTIMATE"
        },
        {
          "title": "The build",
          "text": "Cut, joined, and assembled in the shop, standing up as far as the ceiling allows. Anything that has to move gets tested here rather than on the day.",
          "src": "assets/img_3342.jpg",
          "caption": "FABRICATION"
        },
        {
          "title": "The finish",
          "text": "Sculpt, texture, and paint. This is the stage that decides whether the thing reads as stone or as plywood pretending, and it is never the stage to compress.",
          "src": "assets/img_7661.jpg",
          "caption": "FINISHING"
        },
        {
          "title": "The load-in",
          "text": "Broken down, trucked, and stood up on location or stage, with a crew who know which panel goes where because they built it. Then struck, and stored for the reshoot nobody has mentioned yet.",
          "src": "assets/img_6021.jpg",
          "caption": "LOAD-IN"
        }
      ]
    },
    {
      "id": "s-about",
